              "character": "Hope",
              "version": "Hope"
            },
            "text": "Scalare."
          },
          {
            "id": "L-S2E04-C02-T04",
            "speaker": {
              "character": "Landon",
              "version": "Hopeless Landon"
            },
            "text": "Hope. How are you always in the right place at the right time?"
          },
          {
