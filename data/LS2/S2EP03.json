      "importance": 3,
      "verified": false,
      "full": {
        "turns": [
          {
            "id": "L-S2E03-C09-T01",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Landon, wait, stay back. You don't know what's out there!"
          },
          {
            "id": "L-S2E03-C09-T02",
            "speaker": {
              "character": "Landon",
              "version": "Hopeless Landon"
            },
            "text": "I have an educated guess."
          },
          {
            "id": "L-S2E03-C09-T03",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I said stay back. Incendia."
          },
          {
            "id": "L-S2E03-C09-T04",
            "speaker": {
              "character": "Landon",
              "version": "Hopeless Landon"
            },
            "text": "Is there a plan \"B\"? Please tell me there's a plan \"B\"."
          },
          {
            "id": "L-S2E03-C09-T05",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Turn around."
          },
          {
            "id": "L-S2E03-C09-T06",
            "speaker": {
              "character": "Landon",
              "version": "Hopeless Landon"
            },
            "text": "Why?"
          },
          {
            "id": "L-S2E03-C09-T07",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Because plan \"B\" involves me getting naked."
          },
          {
            "id": "L-S2E03-C09-T08",
            "speaker": {
              "character": "Landon",
              "version": "Hopeless Landon"
            },
            "text": "What?"
          },
          {
            "id": "L-S2E03-C09-T09",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I have to draw it away from you."
          },
          {
            "id": "L-S2E03-C09-T10",
            "speaker": {
              "character": "Landon",
              "version": "Hopeless Landon"
            },
            "text": "Why does that require nudity?"
          },
          {
            "id": "L-S2E03-C09-T11",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Because this monster feeds on werewolves."
          },
          {
            "id": "L-S2E03-C09-T12",
            "speaker": {
              "character": "Landon",
              "version": "Hopeless Landon"
            },
            "text": "But you're a witch. A lying witch. A lying, very naked witch."
          },
          {
            "id": "L-S2E03-C09-T13",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Look, I'm more than that, and I wish I could stay and tell you all about it, but I can't. So when I draw this thing away from you, I need you to go find Dr. Saltzman and Raf."
          },
          {
            "id": "L-S2E03-C09-T14",
            "speaker": {
              "character": "Landon",
              "version": "Hopeless Landon"
            },
            "text": "Why would it chase after you... Because you're a were-witch. Holy smokes."
          }
        ]
      },
