          "version": "Wade"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "banter",
        "comedy"
      ],
      "importance": 1,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S2E10-C04-T01",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Which way?"
          },
          {
            "id": "L-S2E10-C04-T02",
            "speaker": {
              "character": "Wade",
              "version": "Wade"
            },
            "text": "I can't see it. I lost it."
          },
          {
            "id": "L-S2E10-C04-T03",
            "speaker": {
              "character": "Hope",
              "version": "Hope influenced by Qareen"
            },
            "text": "Lost what? Landon's fashion sense? Sorry, I didn't mean that."
          },
          {
            "id": "L-S2E10-C04-T04",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "You said my look was classic."
          },
          {
            "id": "L-S2E10-C04-T05",
            "speaker": {
              "character": "Lizzie",
              "version": "Lizzie"
            },
            "text": "And you believed that? Sorry... I think."
          },
          {
            "id": "L-S2E10-C04-T06",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Well, I'm living a lie."
          },
          {
            "id": "L-S2E10-C04-T07",
            "speaker": {
              "character": "Wade",
              "version": "Wade"
            },
            "text": "We're looking for the Qareen. It's a monster that makes everyone act like..."
          },
          {
            "id": "L-S2E10-C04-T08",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "You."
          },
          {
            "id": "L-S2E10-C04-T09",
            "speaker": {
              "character": "Wade",
              "version": "Wade"
            },
            "text": "It's invisible; only fairies can see it."
          },
          {
            "id": "L-S2E10-C04-T10",
            "speaker": {
              "character": "Lizzie",
              "version": "Lizzie"
            },
            "text": "Do you want to take this, or should I?"
          },
          {
            "id": "L-S2E10-C04-T11",
            "speaker": {
              "character": "Hope",
              "version": "Hope influenced by Qareen"
            },
            "text": "It's too easy. Can't even get any pleasure out of it. Sorry."
          },
          {
            "id": "L-S2E10-C04-T12",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Hey, focus. It's gaining strength by the minute. Once it's strong enough to manifest itself on a, um, non-fairy plane... Anyway, we have to figure out a way to stop it."
          },
          {
            "id": "L-S2E10-C04-T13",
            "speaker": {
              "character": "Lizzie",
              "version": "Lizzie"
            },
            "text": "It is so much less impressive when you give the hero speeches. That was all me."
          },
          {
            "id": "L-S2E10-C04-T14",
            "speaker": {
              "character": "Hope",
              "version": "Hope influenced by Qareen"
            },
            "text": "Okay, what's the plan?"
          }
        ]
      },
      "short": {
        "turns": [
          {
            "id": "L-S2E10-C04-T03",
            "speaker": {
              "character": "Hope",
              "version": "Hope influenced by Qareen"
            },
            "text": "Lost what? Landon's fashion sense? Sorry, I didn't mean that."
          },
          {
            "id": "L-S2E10-C04-T04",
