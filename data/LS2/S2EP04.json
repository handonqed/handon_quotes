    {
      "id": "L-S2E04-C04",
      "title": "Hope goes to convince Landon not to sacrifice himself.",
      "description": "Hope goes to convince Landon not to sacrifice himself.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Josie",
          "version": "Josie"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "angst",
        "protect"
      ],
      "importance": 3,
      "verified": false,
      "full": {
        "turns": [
          {
            "id": "L-S2E04-C04-T01",
            "speaker": {
              "character": "Josie",
              "version": "Josie"
            },
            "text": "Did you find Raf?"
          },
          {
            "id": "L-S2E04-C04-T02",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Yeah. We sent him back to campus. The Oni wasn't in him, so it could be anywhere."
          },
          {
            "id": "L-S2E04-C04-T03",
            "speaker": {
              "character": "Josie",
              "version": "Josie"
            },
            "text": "I'll find it. As long as you convince Landon not to sacrifice himself to stop this thing."
          },
          {
            "id": "L-S2E04-C04-T04",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "No!"
          },
          {
            "id": "L-S2E04-C04-T05",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Uh, no, he-he can't do that. I mean, we can't give the monster what it wants."
          },
          {
            "id": "L-S2E04-C04-T06",
            "speaker": {
              "character": "Josie",
              "version": "Josie"
            },
            "text": "Especially when what it wants is my boyfriend. Who's only doing this because he thinks that it's all his fault."
          },
          {
            "id": "L-S2E04-C04-T07",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Why don't I try to talk some sense into him. Okay?"
          }
        ]
      },
      "short": {
        "turns": [
          {
            "id": "L-S2E04-C04-T03",
            "speaker": {
              "character": "Josie",
              "version": "Josie"
            },
            "text": "I'll find it. As long as you convince Landon not to sacrifice himself to stop this thing."
          },
          {
            "id": "L-S2E04-C04-T04",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "No!"
          },
          {
            "id": "L-S2E04-C04-T05",
