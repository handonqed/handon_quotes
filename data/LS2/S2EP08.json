    {
      "id": "L-S2E08-C04",
      "title": "Landon and Josie obviously finally officially break up.",
      "description": "Landon officially breaks up with Josie, and Josie says it for him: he is in love with Hope.",
      "participants": [
        {
          "character": "Landon",
          "version": "Landon"
        },
        {
          "character": "Josie",
          "version": "Josie"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "choice"
      ],
      "importance": 4,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S2E08-C04-T01",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Hey, Jo. Merry Christmas, I guess?"
          },
          {
            "id": "L-S2E08-C04-T02",
            "speaker": {
              "character": "Josie",
              "version": "Josie"
            },
            "text": "You know what's weird about Christmas? It's, um... the happiest and the saddest."
          },
          {
            "id": "L-S2E08-C04-T03",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Can we start with the happy?"
          },
          {
            "id": "L-S2E08-C04-T04",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "A person could not ask for a better partner, a better conscience. You are literally the best person that's ever had the poor judgement to hang out with me."
          },
          {
            "id": "L-S2E08-C04-T05",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "I love the way you laugh. And your upside down mouth. The way your face looks when you watch movies and..."
          },
          {
            "id": "L-S2E08-C04-T06",
            "speaker": {
              "character": "Josie",
              "version": "Josie"
            },
            "text": "You're in love with Hope."
          },
          {
            "id": "L-S2E08-C04-T07",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "But that doesn't mean I regret a single second. Because you are beautiful. And special. And perfect. And doing the right thing should never be this hard."
          }
        ]
      },
      "short": {
        "turns": [
          {
            "id": "L-S2E08-C04-T05",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "I love the way you laugh. And your upside down mouth. The way your face looks when you watch movies and..."
          },
          {
            "id": "L-S2E08-C04-T06",
