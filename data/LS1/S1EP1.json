    {
      "id": "L-S1E01-C09",
      "title": "Hope and Landon talk in the library, unicorn",
      "description": "Hope and Landon talk  in the library, second part",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Landon",
          "version": "Landon"
        }

      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "memories",
        "explanation",
        "comfort"
      ],
      "importance": 5,
      "verified": true,


       "full": {
        "turns": [
         {
          "id": "L-S1E01-C09-T01",
          "speaker": {
          "character": "Hope",
          "version": "Hope"
          },
          "text": "The blood that runs through my veins isn't human. My dad was one of the earth's Original Vampires."
          },
          {
         "id": "L-S1E01-C09-T02",
         "speaker": {
          "character": "Landon",
          "version": "Landon"
         },
         "text": "Was?"
        },
       {
        "id": "L-S1E01-C09-T03",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "Was. Turns out even immortal beings can find a way to die eventually."
      },
      {
        "id": "L-S1E01-C09-T04",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": " Klaus Mikaelson:The Great Evil."
      },
      {
        "id": "L-S1E01-C09-T05",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "He wasn't very popular around here."
      },
      {
        "id": "L-S1E01-C09-T06",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "One of my foster dads used to burn us with his cigarettes. I guess evil is relative."
      },
      {
        "id": "L-S1E01-C09-T07",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "My mother was a werewolf alpha."
      },
      {
        "id": "L-S1E01-C09-T08",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "There's that was again."
      },
      {
        "id": "L-S1E01-C09-T09",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "The people I care about have a tendency to die on me. I try not to get close to people anymore."
      },
       {
        "id": "L-S1E01-C09-T10",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Yeah, I can see that."
      },
      {
        "id": "L-S1E01-C09-T11",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "Um, my grandmother was a witch. So, all of those things passed down, making me..."
      },
      {
        "id": "L-S1E01-C09-T12",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "A unicorn?"
      },
      {
        "id": "L-S1E01-C09-T13",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "A hybrid of three different creatures, tribrid. I can control when I turn, which is what I was doing tonight. I'm the only one of my kind."
      },
       {
        "id": "L-S1E01-C09-T14",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Yeah. See? Unicorn."
      }
  
    
    
    ]
  },

  "short": {
    "turns": [
