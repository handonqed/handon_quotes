    {
      "id": "L-S2E02-C02",
      "title": "Hope tells Alaric that the boy she loves has moved on.",
      "description": "Hope goes back to Alaric and tells him who she really is: everyone has forgotten her, Landon has moved on, and she doesn't know what to do next.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Alaric",
          "version": "Alaric"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
