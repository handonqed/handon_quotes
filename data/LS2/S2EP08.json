            },
            "action": "stare"
          },
          {
            "id": "L-S2E08-C03-T04",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "This is the part where you say something."
          },
          {
            "id": "L-S2E08-C03-T05",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Or run."
          },
