    {
      "id": "TO-S05E12-C02",
      "title": "Hope and Landon dance",
      "description": "Hope spends part of her final hours dancing with Landon at the festival.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Landon",
          "version": "Landon"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "dance",
        "festival",
        "romantic",
        "hope-dying",
        "foreshadowing"
      ],
      "importance": 5,
      "verified": true,
       "full": {
        "turns": [
         {
          "id": "TO-S5EP12-C02-T01",
          "speaker": {
          "character": "Landon",
          "version": "Landon"
          },
          "text": "I thought you had to be somewhere."
          },
          {
         "id": "TO-S5EP12-C02-T02",
         "speaker": {
          "character": "Hope",
          "version": "Hope"
         },
         "text": "Uh, yeah, actually, it turns out I'm gonna be here for a little bit. Though I do have a curfew pretty soon."
        },
       {
        "id": "TO-S5EP12-C02-T03",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Ah. The private school behind the iron gates doesn't want their fancy students hanging out with townie riffraff too late? Shocking."
      },
      {
        "id": "TO-S5EP12-C02-T04",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "No. There's plenty of riffraff behind those gates. Trust me."
      },
      {
        "id": "TO-S5EP12-C02-T05",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "So, you know that, uh, that jerk from the Grill earlier? Apparently, he totally wrecked his car today. And now you're here, and the music's good, so before my luck runs out, which it will... do you maybe want to dance or something?"
      },
      {
        "id": "TO-S5EP12-C02-T06",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "You want me to dance with you?"
      },
      {
        "id": "TO-S5EP12-C02-T07",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Fair warning, I might suck at it. I haven't really thought this whole thing through. Kind of living in the moment here."
      },
      {
        "id": "TO-S5EP12-C02-T08",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "No, it's... you know, I should probably do more of that myself. Okay."
      }
    ]
  },

