      "importance": 2,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S1E14-C10-T01",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Hey. Where have you been?"
          },
          {
            "id": "L-S1E14-C10-T02",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Are you okay? Why do you smell like a bar?"
          },
          {
            "id": "L-S1E14-C10-T03",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Penelope Park told me that you are keeping a secret... about my mom. She says that we met her and that I don't remember it... but you do."
          },
          {
            "id": "L-S1E14-C10-T04",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "She's lying, right? Just tell me she's lying, Hope."
          },
          {
            "id": "L-S1E14-C10-T05",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "You know, I wasn't always the most honest person, but... you were the one that taught me the value in being truthful. And the truth... I can't be here right now."
          },
          {
            "id": "L-S1E14-C10-T06",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Landon, Landon."
          }
          
        ]
      },
      "short": {
        "turns": [
          {
            "id": "L-S1E14-C10-T04",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "She's lying, right? Just tell me she's lying, Hope."
          },
          {
            "id": "L-S1E14-C10-T05",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "You know, I wasn't always the most honest person, but...you were the one that taught me the value in being truthful. And the truth... I can't be here right now."
          },
          {
            "id": "L-S1E14-C10-T06",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Landon, Landon."
          }
        ]
      }
    },
    
    {
      "id": "L-S1E14-C11",
      "title": "Hope wants to find Landon after their fight.",
      "description": "Hope wants to find Landon after their fight, and Lizzie offers to help her reconcile with him.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Lizzie",
          "version": "Lizzie"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "reconciliation",
        "relationship"
      ],
      "importance": 3,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S1E14-C11-T01",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I need to go find Landon."
          },
          {
            "id": "L-S1E14-C11-T02",
            "speaker": {
              "character": "Lizzie",
              "version": "Lizzie"
            },
            "text": "Just give him a minute to breathe. Boys need some space before they come crawling back."
          },
          {
            "id": "L-S1E14-C11-T03",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I thought I could keep it all together. I've worked so hard to move on from all the things that have happened to me in my life. But everyone was right. Everyone's been right."
          },
          {
            "id": "L-S1E14-C11-T04",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I needed to, like, let it all out. How did you know what to say? How'd you know what to do?"
          },
          {
            "id": "L-S1E14-C11-T05",
            "speaker": {
              "character": "Lizzie",
              "version": "Lizzie"
            },
            "text": "It's just what Josie's done for me a thousand times. She's really mad at me. I don't think I've ever seen her so angry."
          },
          {
            "id": "L-S1E14-C11-T06",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Landon's pretty mad at me, too."
          },
          {
            "id": "L-S1E14-C11-T07",
            "speaker": {
              "character": "Lizzie",
              "version": "Lizzie"
            },
            "text": "Then let's make a deal. You help me get Josie back, and I'll help you get Landon."
          }
          
        ]
      },
      "short": {
        "turns": [
          {
            "id": "L-S1E14-C11-T01",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I need to go find Landon."
          },
          {
            "id": "L-S1E14-C11-T02",
            "speaker": {
              "character": "Lizzie",
              "version": "Lizzie"
            },
            "text": "Just give him a minute to breathe. Boys need some space before they come crawling back."
          },
          {
            "id": "L-S1E14-C11-T03",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I thought I could keep it all together. I've worked so hard to move on from all the things that have happened to me in my life."
          }
        ]
      }
    },
    {
      "id": "L-S1E14-C12",
      "title": "Landon confronts Alaric about Hope's secret.",
      "description": "Landon confronts Alaric about Hope's secret",
      "participants": [
