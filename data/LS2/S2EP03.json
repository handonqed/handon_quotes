      "importance": 2,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S2E03-C06-T01",
            "speaker": {
              "character": "Josie",
              "version": "Josie"
            },
            "text": "What was that all about?"
          },
          {
            "id": "L-S2E03-C06-T02",
            "speaker": {
              "character": "Landon",
              "version": "Hopeless Landon"
            },
            "text": "Josie. I hurt her."
          },
          {
            "id": "L-S2E03-C06-T03",
            "speaker": {
              "character": "Josie",
              "version": "Josie"
            },
            "text": "No, you didn't, she's fine. She was clearly faking."
          },
          {
            "id": "L-S2E03-C06-T04",
            "speaker": {
              "character": "Landon",
              "version": "Hopeless Landon"
            },
            "text": "Why would she fake something like that?"
          },
          {
            "id": "L-S2E03-C06-T05",
            "speaker": {
              "character": "Josie",
              "version": "Josie"
            },
            "text": "Why are you taking her side?"
          },
          {
            "id": "L-S2E03-C06-T06",
            "speaker": {
              "character": "Landon",
              "version": "Hopeless Landon"
            },
            "text": "It's not about sides. I'm just being a decent human being."
          },
          {
            "id": "L-S2E03-C06-T07",
            "speaker": {
              "character": "Josie",
              "version": "Josie"
            },
            "text": "Well, you're not a human, you're a phoenix. This is a game where there are sides. Plus, I mean, there's something off about her. I just... I don't know what, but there's something."
          },
          {
            "id": "L-S2E03-C06-T08",
            "speaker": {
              "character": "Landon",
              "version": "Hopeless Landon"
            },
            "text": "Yeah, she's not the only one."
          }
        ]
      },
