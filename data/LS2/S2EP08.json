    {
      "id": "L-S2E08-C05",
      "title": "Handon says they love each other and kiss.",
      "description": "Landon tells Hope that leaving was a mistake and that he loved her when he couldn't remember her and even when he was dead. Hope says it back.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Landon",
          "version": "Landon"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "confession",
        "love",
        "reunion",
        "memories",
        "happy",
        "kiss"
      ],
      "importance": 5,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S2E08-C05-T01",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "I thought leaving was the right thing to do. But I was wrong."
          },
          {
            "id": "L-S2E08-C05-T02",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "action": "gently strokes her hair"
          },
          {
            "id": "L-S2E08-C05-T03",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "That's what I came back to say."
          },
          {
            "id": "L-S2E08-C05-T04",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "I love you, Hope Mikaelson. I-I loved you when I couldn't remember you. I love you as I'm standing here right now."
          },
          {
            "id": "L-S2E08-C05-T05",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Hope, I loved you when I was dead. I think I always will."
          },
          {
            "id": "L-S2E08-C05-T06",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "This is the part where you say..."
          },
          {
            "id": "L-S2E08-C05-T07",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "That I love you, too, Landon Kirby. God, I loved you when you didn't even know it."
          },
          {
            "id": "L-S2E08-C05-T08",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Despite the way you've looked in a football uniform."
          },
          {
            "id": "L-S2E08-C05-T09",
            "speaker": {
              "character": "Handon",
              "version": "Handon"
            },
            "action": "laugh"
          },
          {
            "id": "L-S2E08-C05-T10",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Then there's only one thing left to say."
          },
          {
            "id": "L-S2E08-C05-T11",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Look up."
          },
          {
            "id": "L-S2E08-C05-T12",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "action": "smiles at seeing the mistletoe"
          },
          {
            "id": "L-S2E08-C05-T13",
            "speaker": {
              "character": "Handon",
              "version": "Handon"
            },
            "action": "kiss"
          }
        ]
      },
