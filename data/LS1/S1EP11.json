    {
      "id": "L-S1E11-C09",
      "title": "Hope and Landon talk before he sings to her",
      "description": "Hope and Landon discuss the slug monster before he sings to her",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Landon",
          "version": "Landon"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "comfort",
        "teasing",
        "kiss"

      ],
      "importance": 4,
      "verified": true,


       "full": {
        "turns": [
         {
          "id": "L-S1E11-C09-T01",
          "speaker": {
          "character": "Hope",
          "version": "Hope"
          },
          "text": "Hi. So it took three showers, but I think I'm finally clean."
          },
          {
         "id": "L-S1E11-C09-T02",
         "speaker": {
          "character": "Landon",
          "version": "Landon"
         },
         "text": "Three of 'em? Wow."
        },
       {
        "id": "L-S1E11-C09-T03",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "Three. Mm-hmm."
      },
      {
        "id": "L-S1E11-C09-T04",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Yeah, I don't have slug envy or anything, but why do you think I wasn't infected? I mean, it got pretty much everybody, except Lizzie, and she had the bracelet. Unless something's just wrong with me."
      },
      {
        "id": "L-S1E11-C09-T05",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "I don't, I don't know."
      },
      {
        "id": "L-S1E11-C09-T06",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Oh, come on. Professional monster hunter Hope Mikaelson doesn't even have a theory?"
      },
      {
        "id": "L-S1E11-C09-T07",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "I guess I'll add it to the list of unexplainable things about Landon Kirby."
      },
      {
        "id": "L-S1E11-C09-T08",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "I was being ridiculous all day. But I was happy. The things I said, how I acted... Maybe it could be that way all the time. Maybe the only thing that's keeping me from being happy is me."
      },
      {
        "id": "L-S1E11-C09-T09",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "You know, if life was about being happy all the time, neither of us would've survived this long."
      },
      {
        "id": "L-S1E11-C09-T10",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Which would be a real shame... because then you would never hear how bad I am at singing. Oh, boy. Uh..."
      }
    
    ]
  },

