            },
            "text": "Would you quit playing games? There is no answer either of us could give that should stop you from doing that right now."
          },
          {
            "id": "L-S2E01-C05-T26",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Are you happy? Is everyone happier now?"
          },
          {
            "id": "L-S2E01-C05-T27",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "action": "cries"
          },
          {
            "id": "L-S2E01-C05-T28",
