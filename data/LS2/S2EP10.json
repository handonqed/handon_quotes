    {
      "id": "L-S2E10-C04",
      "title": "Hope mocks Landon's fashion sense.",
      "description": "While Landon and Wade hunt the Qareen, an infected Hope makes fun of Landon's look and Wade's fairy theory.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope influenced by Qareen"
        },
        {
          "character": "Landon",
          "version": "Landon"
        },
        {
          "character": "Lizzie",
