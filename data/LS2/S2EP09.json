  "conversations": [
    {
      "id": "L-S2E09-C01",
      "title": "Hope and Alaric discuss the changes at school and that Josie needs time.",
      "description": "Back at school, Hope tells Alaric that things with Josie are bad again, and he explains that knowing she and Landon are together is different from seeing it.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Alaric",
          "version": "Alaric"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [],
      "importance": 1,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S2E09-C01-T01",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "You're late for class. Or are you lost?"
          },
          {
            "id": "L-S2E09-C01-T02",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Uh, both. Apparently, everything changed when I was gone. Where's spell lab?"
          },
          {
            "id": "L-S2E09-C01-T03",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "No idea. I'm a little out of the loop myself. I just like to stride confidently and, uh, nod in hopes that people don't figure that out."
          },
          {
            "id": "L-S2E09-C01-T04",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "But speaking of being out of the loop, Lizzie and Josie are avoiding me. Why? What's up?"
          },
          {
            "id": "L-S2E09-C01-T05",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I wouldn't know. Things are still awkward between me and Josie. I mean, I thought they were okay. It's just bad again."
          },
          {
            "id": "L-S2E09-C01-T06",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Yeah, well, knowing you and Landon are together and seeing it are two very different things."
          },
          {
            "id": "L-S2E09-C01-T07",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I just wish there was something I could do."
          },
          {
            "id": "L-S2E09-C01-T08",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "You just have to give her some time, you know? Things will go back to normal soon enough. I hope."
          },
          {
            "id": "L-S2E09-C01-T09",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Yeah."
          },
          {
            "id": "L-S2E09-C01-T10",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Spell lab."
          },
          {
            "id": "L-S2E09-C01-T11",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Oh!"
          }
        ]
      },
      "short": {
        "turns": [
          {
            "id": "L-S2E09-C01-T05",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Things are still awkward between me and Josie. I mean, I thought they were okay. It's just bad again."
          },
          {
            "id": "L-S2E09-C01-T06",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Yeah, well, knowing you and Landon are together and seeing it are two very different things."
          }
        ]
      }
    },
