    {
      "id": "L-S2E03-C07",
      "title": "Landon catches Hope doing magic in his room.",
      "description": "Landon finds Hope in his room casting a locator spell for Rafael. She tells him she is a witch working with Alaric, and he insists on going with her.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Landon",
          "version": "Hopeless Landon"
        }
      ],
