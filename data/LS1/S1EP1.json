      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "angst"
      ],
      "importance": 1,
      "verified": true,


       "full": {
        "turns": [
         {
          "id": "L-S1E01-C12-T01",
          "speaker": {
          "character": "Hope",
          "version": "Hope"
          },
          "text": "How do you know it was him?"
          },
          {
         "id": "L-S1E01-C12-T02",
         "speaker": {
          "character": "Alaric",
          "version": "Alaric"
         },
         "text": "Ancient artifact goes missing along with too good to be true hapless human? You do the math, Hope."
        },
 
      {
        "id": "L-S1E01-C12-T03",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "That would make him a liar, okay? I've known my fair share of those, and there was nothing about him..."
      },
      {
        "id": "L-S1E01-C12-T04",
        "speaker": {
          "character": "Alaric",
          "version": "Alaric"
        },
        "text": "Hope..."
      },
      {
        "id": "L-S1E01-C12-T05",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "No, you don't understand. There's no way that the one time that I choose to get close to someone, they turn out to be a liar. It's not possible, okay? I'm not that stupid."
      }
      
       
    
    ]
  },

