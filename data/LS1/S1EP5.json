    {
      "id": "L-S1E05-C01",
      "title": "Hope and Landon begin the tests",
      "description": "Hope administers the tests that will help determine whether Landon can stay at the school, while Landon challenges her perceived bias.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Landon",
          "version": "Landon"
        }
      ],
      "subjects": [
      ],
      "scene_type": "conversation",
      "tags": [
        "testing",
        "bias",
        "trust",
        "belonging"
      ],
      "importance": 3,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S1E05-C01-T01",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "What are you doing here?"
          },
          {
            "id": "L-S1E05-C01-T02",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Dr. Saltzman wanted me to administer your tests, starting with some weird mystical blood analysis."
          },
          {
            "id": "L-S1E05-C01-T03",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "No."
          },
           {
            "id": "L-S1E05-C01-T04",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Excuse me?"
          },
          {
            "id": "L-S1E05-C01-T05",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "No. These tests determine whether or not I get to stay at the school, right? There is no way I'm putting my future in your hands; you're biased."
          },
          {
            "id": "L-S1E05-C01-T06",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I'm not biased. Besides, neither of us has a choice. Believe me, this is not how I would choose to spend my day, either."
          },
          {
            "id": "L-S1E05-C01-T07",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "See? Biased."
          },
          {
            "id": "L-S1E05-C01-T08",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Landon. Last thing that you told me was that you wanted to find answers about who or what you are. I want those answers, too. So let's just get through this."
          }
     
          
        ]
      },
      "short": {
        "turns": [
          {
            "id": "L-S1E05-C01-T05",
            "speaker": {
