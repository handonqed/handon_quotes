  "conversations": [
    {
      "id": "L-S2E07-C01",
      "title": "Landon reflects on remembering Hope.",
      "description": "In voice-over, Landon describes what it is like to realize that a memory he took for a dream was real, and to start the day burdened with a choice.",
      "participants": [
        {
          "character": "Landon",
          "version": "Landon"
        }
      ],
      "subjects": [],
      "scene_type": "speech",
      "tags": [
