      "importance": 2,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S1E14-C12-T01",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Did you know?"
          },
          {
            "id": "L-S1E14-C12-T02",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "After the day I've had, I'm gonna need you to be a little more specific, Landon. I was a lawn ornament until about ten minutes ago."
          },
          {
            "id": "L-S1E14-C12-T03",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Did you know that Hope remembered meeting my mom? Did you know that she was lying to me about it?"
          },
          {
            "id": "L-S1E14-C12-T04",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Yeah, I did."
          },
          {
            "id": "L-S1E14-C12-T05",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "So you're a liar, too."
          },
          {
            "id": "L-S1E14-C12-T06",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "If you're looking for someone to blame, go ahead, you can blame me. I can take it. But just cut Hope a little slack, okay? She just wanted to protect you."
          },
          {
            "id": "L-S1E14-C12-T07",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Protect me? I can't deal with this right now."
          }
          
        ]
      },
      "short": {
        "turns": [
          {
            "id": "L-S1E14-C12-T06",
