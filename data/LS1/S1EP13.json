  "conversations": [
    {
      "id": "L-S1E13-C01",
      "title": "Hope searches for Landon",
      "description": "Hope becomes increasingly worried when Landon is missing after the trip during the full moon.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Alaric",
          "version": "Alaric"
        },
        {
          "character": "Rafael",
          "version": "Rafael"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "missing",
        "worry",
        "search"
      ],
      "importance": 2,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S1E13-C01-T01",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Have you seen Landon? I thought he might be down here with Raf for moral support."
          },
          {
            "id": "L-S1E13-C01-T02",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Raf's not here."
          },
          {
            "id": "L-S1E13-C01-T03",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Wait, he's... What?"
          },
          {
            "id": "L-S1E13-C01-T04",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "The supervisors said he didn't check in. And now MG's missing, too."
          },
          {
            "id": "L-S1E13-C01-T05",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "But it's a full moon. Oh, God."
          },
          {
            "id": "L-S1E13-C01-T06",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I don't know why my locator spell didn't work."
          },
          {
            "id": "L-S1E13-C01-T07",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "If you can't find them, it means they're being cloaked or..."
          },
          {
            "id": "L-S1E13-C01-T08",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Or they're dead. I'm aware."
          },
          {
            "id": "L-S1E13-C01-T09",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "What would possess them to leave campus? Why would they be so irresponsible?"
          },

          {
            "id": "L-S1E13-C01-T10",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "They wouldn't. Something must have happened."
          },
          {
            "id": "L-S1E13-C01-T11",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Raf? Raf! Hey, are you okay?"
          },
          {
            "id": "L-S1E13-C01-T12",
            "speaker": {
              "character": "Rafael",
              "version": "Rafael"
            },
            "text": "MG... Landon..."
          },
          
          {
            "id": "L-S1E13-C01-T13",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Hey, what's going on? Where's Landon?"
          },
          {
            "id": "L-S1E13-C01-T14",
            "speaker": {
              "character": "Rafael",
              "version": "Rafael"
            },
            "text": "I can't remember."
          }
        ]
      },
      "short": {
        "turns": [
          {
            "id": "L-S1E13-C01-T13",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Hey, what's going on? Where's Landon?"
          }
        ]
      }
    },
    {
      "id": "L-S1E13-C02",
      "title": "Hope asks Rafael about what happened with Landon.",
      "description": "Hope presses Emma for answers after Rafael reveals that Landon is being chased by a monster.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Emma",
          "version": "Emma"
        },
        {
          "character": "Rafael",
          "version": "Rafael"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "monster",
        "worry",
        "protect"
      ],
      "importance": 2,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S1E13-C02-T01",
            "speaker": {
              "character": "Rafael",
              "version": "Rafael"
            },
            "text": "Landon! No!"
          },
          {
            "id": "L-S1E13-C02-T02",
            "speaker": {
              "character": "Emma",
              "version": "Emma"
            },
            "text": "It's happening again. Hand me the syringe."
          },
          {
            "id": "L-S1E13-C02-T03",
            "speaker": {
              "character": "Emma",
              "version": "Emma"
            },
            "text": "Wait, he's about to tell us what happened to Landon."
          },
          {
            "id": "L-S1E13-C02-T04",
            "speaker": {
              "character": "Emma",
              "version": "Emma"
            },
            "text": "And if he stays in this state any longer, it'll be that much harder to pull him out."
          },
          {
            "id": "L-S1E13-C02-T05",
            "speaker": {
              "character": "Rafael",
              "version": "Rafael"
            },
            "text": "Landon! Run!"
          },
          {
            "id": "L-S1E13-C02-T06",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Raf! Hey, it's okay. Tell me who's running after Landon. Please. Who's chasing Landon?"
          },
          {
            "id": "L-S1E13-C02-T07",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Hey, hey, hey..."
          },
          {
            "id": "L-S1E13-C02-T08",
            "speaker": {
              "character": "Rafael",
              "version": "Rafael"
            },
            "text": "A monster."
          },
          {
            "id": "L-S1E13-C02-T09",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "It doesn't make any sense. Triad has the urn. There shouldn't be any more monsters, certainly none that made their way through Maryland."
          },
          {
            "id": "L-S1E13-C02-T10",
            "speaker": {
              "character": "Emma",
              "version": "Emma"
            },
            "text": "He's obviously confused."
          },
          {
            "id": "L-S1E13-C02-T11",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "We need to wake him up."
          },
          {
            "id": "L-S1E13-C02-T12",
            "speaker": {
              "character": "Emma",
              "version": "Emma"
            },
            "text": "Sleep is the safest thing for him right now. Once he's out of this lunar cycle, we'll be able to recalibrate his brain more easily."
          },
          {
            "id": "L-S1E13-C02-T13",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "But he's the only one who knows where Landon and MG are. Plus, monster?"
          },
          {
            "id": "L-S1E13-C02-T14",
            "speaker": {
              "character": "Emma",
              "version": "Emma"
            },
            "text": "I heard. But as the closest thing this school has to a psychiatrist, my responsibility is to him. And to you. You and I talked a lot about triggers rooted in trauma."
          },
          {
            "id": "L-S1E13-C02-T15",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I don't need a therapist right now, Emma. I need answers."
          }
        ]
      },
      "short": {
        "turns": [
          {
            "id": "L-S1E13-C02-T03",
            "speaker": {
              "character": "Emma",
              "version": "Emma"
            },
            "text": "Wait, he's about to tell us what happened to Landon."
          },
          {
            "id": "L-S1E13-C02-T04",
            "speaker": {
              "character": "Emma",
              "version": "Emma"
            },
            "text": "And if he stays in this state any longer, it'll be that much harder to pull him out."
          },
          {
            "id": "L-S1E13-C02-T05",
            "speaker": {
              "character": "Rafael",
              "version": "Rafael"
            },
            "text": "Landon! Run!"
          },
          {
            "id": "L-S1E13-C02-T06",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Raf! Hey, it's okay. Tell me who's running after Landon. Please. Who's chasing Landon?"
          }
        ]
      }
    },
    {
      "id": "L-S1E13-C03",
      "title": "Hope forces the truth about Landon",
      "description": "Hope insists on using Rafael's memories to find out what happened to Landon despite Emma's concerns.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Alaric",
          "version": "Alaric"
        },
        {
          "character": "Emma",
          "version": "Emma"
        },
        {
          "character": "Rafael",
          "version": "Rafael"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "protect",
        "worry",
        "care"
      ],
      "importance": 2,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S1E13-C03-T01",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Did you find them?"
          },
          {
            "id": "L-S1E13-C03-T02",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "No, not yet. What did you learn?"
          },
          {
            "id": "L-S1E13-C03-T03",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Raf said they got attacked by a monster."
          },
          {
            "id": "L-S1E13-C03-T04",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Well, that's impossible."
          },
          {
            "id": "L-S1E13-C03-T05",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Is it?"
          },
          {
            "id": "L-S1E13-C03-T06",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Where? And when?"
          },
          {
            "id": "L-S1E13-C03-T07",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I-I don't know. I don't know. Emma sedated him, and he's been sleeping it off for hours."
          },
          {
            "id": "L-S1E13-C03-T08",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "But I have an idea. It's a family recipe from my mom's side, the Crescent Pack. Because they could control their turns at will, they had access to both sides of their minds."
          },
          {
            "id": "L-S1E13-C03-T09",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "All right, well, do what you need to do. I've got to find MG before his father sees him."
          },
          {
            "id": "L-S1E13-C03-T10",
            "speaker": {
              "character": "Emma",
              "version": "Emma"
            },
            "text": "Absolutely not."
          },
          {
            "id": "L-S1E13-C03-T11",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "This elixir has been in my family for years. Dr. Saltzman said that I..."
          },
          {
            "id": "L-S1E13-C03-T12",
            "speaker": {
              "character": "Emma",
              "version": "Emma"
            },
            "text": "Dr. Saltzman, bless him, is not a medical doctor. Nor am I. And most definitely neither are you. The division between the two sides of Rafael's mind exists for a reason, to protect his sanity and to..."
          },
          {
            "id": "L-S1E13-C03-T13",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Emma, please. Obviously, something terrible happened. Landon and MG are out there somewhere."
          },
          {
            "id": "L-S1E13-C03-T14",
            "speaker": {
              "character": "Emma",
              "version": "Emma"
            },
            "text": "Do you think I'm not concerned about them? Of course I am."
          },
          {
            "id": "L-S1E13-C03-T15",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Then we need to do something."
          },
          {
            "id": "L-S1E13-C03-T16",
            "speaker": {
              "character": "Emma",
              "version": "Emma"
            },
            "text": "Hope, I said no. And I'm not gonna let you..."
          },
          {
            "id": "L-S1E13-C03-T17",
            "speaker": {
              "character": "Rafael",
              "version": "Rafael"
            },
            "text": "I'm sorry, Emma. But Hope's right. Do what you got to do."
          }
        ]
      },
      "short": {
        "turns": [
          {
            "id": "L-S1E13-C03-T13",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": " Emma, please. Obviously, something terrible happened. Landon and MG are out there somewhere."
          },
          {
            "id": "L-S1E13-C03-T14",
            "speaker": {
              "character": "Emma",
              "version": "Emma"
            },
            "text": "Do you think I'm not concerned about them? Of course I am.."
          },
          {
            "id": "L-S1E13-C03-T15",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Then we need to do something."
          }
        ]
      }
    },
    
    
    {
      "id": "L-S1E13-C04",
      "title": "Hope learns Landon may be in danger",
      "description": "After Rafael remembers the woods, Hope realizes Landon may still be alive and immediately sets out to find him.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Rafael",
          "version": "Rafael"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "worry",
        "search",
        "protect",
        "rescue"
      ],
      "importance": 3,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S1E13-C04-T01",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Hey. Hey. Here. Here. Here, here, here, here. Drink this."
          },
          {
            "id": "L-S1E13-C04-T02",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Hey. What did you see? What did you see? What were you running from?"
          },
          {
            "id": "L-S1E13-C04-T03",
            "speaker": {
              "character": "Rafael",
              "version": "Rafael"
            },
            "text": "I don't know. I don't know!"
          },
          {
            "id": "L-S1E13-C04-T04",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Raf, whatever you saw is what made you like this."
          },
          {
            "id": "L-S1E13-C04-T05",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Did the monster hurt Landon?"
          },
          {
            "id": "L-S1E13-C04-T06",
            "speaker": {
              "character": "Rafael",
              "version": "Rafael"
            },
            "text": "I don't know."
          },
          {
            "id": "L-S1E13-C04-T07",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Is Landon okay, Raf?!"
          },
          {
            "id": "L-S1E13-C04-T08",
            "speaker": {
              "character": "Rafael",
              "version": "Rafael"
            },
            "text": "I don't know, Hope. I don't know."
          },
          {
            "id": "L-S1E13-C04-T09",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Okay. Do you remember where the woods were?"
          },
          {
            "id": "L-S1E13-C04-T10",
            "speaker": {
              "character": "Rafael",
              "version": "Rafael"
            },
            "text": "I think so. Yeah, I remember."
          },
          {
            "id": "L-S1E13-C04-T11",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Okay. Okay."
          },
          {
            "id": "L-S1E13-C04-T12",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I'm gonna get one of the twins to siphon you out of here."
          },
          {
            "id": "L-S1E13-C04-T13",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "We're gonna go find him."
          }
        ]
      },
      "short": {
        "turns": [
          {
            "id": "L-S1E13-C04-T05",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Did the monster hurt Landon?"
          },
          {
            "id": "L-S1E13-C04-T06",
            "speaker": {
              "character": "Rafael",
              "version": "Rafael"
            },
            "text": "I don't know."
          },
          {
            "id": "L-S1E13-C04-T07",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Is Landon okay, Raf?!"
          }
        ]
      }
    },
    
    {
      "id": "L-S1E13-C05",
      "title": "Hope finds Landon's body.",
      "description": "Hope finds Landon's body.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
