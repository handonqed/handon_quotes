    {
      "id": "L-S1E16-C05",
      "title": "Hope and Landon say \"I love you\" for the first time.",
      "description": "After the fight, Hope drops the speech she practiced with the hologram and tells Landon the truth: she loves him. Landon says it back and forgives her.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Landon",
          "version": "Landon"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "confession",
        "love",
        "sorry",
        "forgiveness",
        "kiss"
      ],
      "importance": 5,
      "verified": false,
      "full": {
        "turns": [
          {
            "id": "L-S1E16-C05-T01",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Hi."
          },
          {
            "id": "L-S1E16-C05-T02",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Hi."
          },
          {
            "id": "L-S1E16-C05-T03",
            "speaker": {
              "character": "Handon",
              "version": "Handon"
            },
            "action": "kiss"
          },
          {
            "id": "L-S1E16-C05-T04",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Um, okay, um... So I had this entire speech that I practiced with your prismatic hologram."
          },
          {
            "id": "L-S1E16-C05-T05",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "My what?"
          },
          {
            "id": "L-S1E16-C05-T06",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "But I know that the only thing you want from me is the truth. And the truth is... I love you."
          },
          {
            "id": "L-S1E16-C05-T07",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I'm really sorry about all the secrets that I've kept, but I'm... I'm mostly sorry about keeping that one. 'Cause I love you, Landon Kirby."
          },
          {
            "id": "L-S1E16-C05-T08",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "I mean, it wasn't a huge secret, because I love you, too, Hope Mikaelson. And I forgive you for anything that needs it."
          },
          {
            "id": "L-S1E16-C05-T09",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "And I know it looked like I was losing when you got here, but that's just how Phoenix combat looks, so..."
          },
          {
            "id": "L-S1E16-C05-T10",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "action": "laugh"
          },
          {
            "id": "L-S1E16-C05-T11",
            "speaker": {
              "character": "Handon",
              "version": "Handon"
            },
            "action": "kiss"
          }
        ]
      },
      "short": {
        "turns": [
         {
            "id": "L-S1E16-C05-T06",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
