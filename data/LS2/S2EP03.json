    {
      "id": "L-S2E03-C01",
      "title": "Hope reflects on the love of her life forgetting her.",
      "description": "In voice-over, Hope says that having the love of your life forget your whole existence makes you want to be alone.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        }
      ],
      "subjects": [],
      "scene_type": "speech",
      "tags": [
