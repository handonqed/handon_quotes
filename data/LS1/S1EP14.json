          {
            "id": "L-S1E14-C07-T08",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Call me crazy, but doesn't this look like MG's mom?"
          },
          {
            "id": "L-S1E14-C07-T09",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I think it is MG's mom."
