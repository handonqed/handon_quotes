{
      "id": "L-S1E01-C05",
      "title": "Hope and Landon talk in the cell",
      "description": "Hope and Landon talk in the cell for the first time",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Landon",
          "version": "Landon"
        }

      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "explanation",
        "comfort",
        "angst"
      ],
      "importance": 3,
      "verified": true,


       "full": {
        "turns": [
         {
          "id": "L-S1E01-C05-T01",
          "speaker": {
          "character": "Hope",
          "version": "Hope"
          },
          "text": "Landon."
          },
          {
         "id": "L-S1E01-C05-T02",
         "speaker": {
          "character": "Landon",
          "version": "Landon"
         },
         "text": "Hope. Can you get me out of here?"
        },
       {
        "id": "L-S1E01-C05-T03",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "Not yet. But you're not a prisoner here I swear."
      },
      {
        "id": "L-S1E01-C05-T04",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "I'm in a witch dungeon."
      },
      {
        "id": "L-S1E01-C05-T05",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "It's a werewolf transition space."
      },
      {
        "id": "L-S1E01-C05-T06",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Super. I'm not so good with, you know... small spaces."
      },
      {
        "id": "L-S1E01-C05-T07",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "We won't keep you here long. No one expected you couldn't be compelled."
      },
      {
        "id": "L-S1E01-C05-T08",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "I don't know what that means."
      },
      {
        "id": "L-S1E01-C05-T09",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "MG tried to erase your memories of this place, but it didn't work."
      },
       {
        "id": "L-S1E01-C05-T10",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "So now what, I'm a hostage? Where's Raf?"
      },
      {
        "id": "L-S1E01-C05-T11",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "He's fine. You're fine, too. Look, compulsion doesn't work on people who take this herb called vervain. The town sheriff sometimes slips it into the coffee at the gas station we were at this morning. It takes about a day to pass through your system, but you just have to wait it out."
      },
      {
        "id": "L-S1E01-C05-T12",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Sure. Yeah, no big deal. Yeah, I'll just sit here alone in the witch dungeon with my thoughts. Would you... I mean... could you wait it out with me?"
      },
    {
        "id": "L-S1E01-C05-T13",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "I'm really sorry about all of this. But it was nice to see you again."
      }
    
    ]
  },

  "short": {
    "turns": [
      {
        "id": "L-S1E01-C05-T12",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Would you... I mean... could you wait it out with me?"
      },
    {
        "id": "L-S1E01-C05-T13",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "I'm really sorry about all of this. But it was nice to see you again."
      }
    ]
  }
