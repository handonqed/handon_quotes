        "angst"
      ],
      "importance": 4,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S2E07-C01-T01",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "action": "flashback of Handon at the Mystic Grill"
          },
          {
            "id": "L-S2E07-C01-T02",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "action": "flashback of Handon dancing"
          },
          {
            "id": "L-S2E07-C01-T03",
