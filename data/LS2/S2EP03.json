            "speaker": {
              "character": "Josie",
              "version": "Josie"
            },
            "text": "You have a problem hitting her or something? She has no problem hitting on you."
          },
          {
            "id": "L-S2E03-C04-T06",
            "speaker": {
              "character": "Landon",
              "version": "Hopeless Landon"
            },
            "text": "Consider her blitzed."
