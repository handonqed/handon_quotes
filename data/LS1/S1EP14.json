    {
      "id": "L-S1E14-C04",
      "title": "Landon tells Hope that they are both indestructible.",
      "description": "Landon notices Hope acting strangely and explains to her that now they are both indestructible.",
      "participants": [
        {
          "character": "Landon",
          "version": "Landon"
        },
        {
          "character": "Hope",
          "version": "Hope"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "relationship",
        "indestructible"
  
      ],
      "importance": 3,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S1E14-C04-T01",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Hey, Hope. You have any idea where these guys go?"
          },
          {
            "id": "L-S1E14-C04-T02",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Yeah, anywhere but with the birds. The ravens and the finches are fine, but the rats drive the owls crazy."
          },
          {
            "id": "L-S1E14-C04-T03",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "So I've been thinking about why you've been acting so weird."
          },
          {
            "id": "L-S1E14-C04-T04",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Suddenly everyone's got a psychology degree around here."
          },
          {
            "id": "L-S1E14-C04-T05",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "No, I just, I just think you have cold feet."
          },
          {
            "id": "L-S1E14-C04-T06",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "About what?"
          },
          {
            "id": "L-S1E14-C04-T07",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Us. You know, we're good."
          },
          {
            "id": "L-S1E14-C04-T08",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "We're finally in a solid relationship based on honesty and openness and..."
          },
          {
            "id": "L-S1E14-C04-T09",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "I'm indestructible. You're relatively indestructible. We finally have a long, clear road ahead of us, you know, with no obstacles."
          },
          {
            "id": "L-S1E14-C04-T10",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Who is that?"
          },
          {
            "id": "L-S1E14-C04-T11",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Um... That is Roman."
          },
          {
            "id": "L-S1E14-C04-T12",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Oh."
          }
        ]
      },
      "short": {
        "turns": [
          {
            "id": "L-S1E14-C04-T07",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Us. You know, we're good."
          },
          {
            "id": "L-S1E14-C04-T08",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "We're finally in a solid relationship based on honesty and openness and..."
          },
          {
            "id": "L-S1E14-C04-T09",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "I'm indestructible. You're relatively indestructible. We finally have a long, clear road ahead of us, you know, with no obstacles."
          }
        ]
      }
