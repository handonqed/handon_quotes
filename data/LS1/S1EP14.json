    {
      "id": "L-S1E14-C09",
      "title": "Landon talks with Penelope about his jealousy.",
      "description": "Landon talks with Penelope about his jealousy.",
      "participants": [
        {
          "character": "Landon",
          "version": "Landon"
        },
        {
          "character": "Penelope",
          "version": "Penelope"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "jealous",
        "honesty"
      ],
      "importance": 2,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S1E14-C09-T01",
            "speaker": {
              "character": "Penelope",
              "version": "Penelope"
            },
            "text": "Mmm. It's not bad."
          },
          {
            "id": "L-S1E14-C09-T02",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "I don't think you've ever spoken to me before."
          },
          {
            "id": "L-S1E14-C09-T03",
            "speaker": {
              "character": "Penelope",
              "version": "Penelope"
            },
            "text": "You've never had free booze before."
          },
          {
            "id": "L-S1E14-C09-T04",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Right. Makes sense."
          },
          {
            "id": "L-S1E14-C09-T05",
            "speaker": {
              "character": "Penelope",
              "version": "Penelope"
            },
            "text": "So, what sorrows are we drowning?"
          },
          {
            "id": "L-S1E14-C09-T06",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "I came back from the dead... in a, in a burst of flames. And you'd think that would earn a guy a couple days of feeling special, but the irony about this place is that... special is just normal. "
          },
          {
            "id": "L-S1E14-C09-T07",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "All it takes is one good-looking vampire, and then I might as well be back at Mystic Falls High. Maybe I should just... tell Hope how jealous I am of Vampire Captain America."
          },
          {
            "id": "L-S1E14-C09-T08",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "I should put it all out there, right? And just say it. If I've learned anything from Hope, it's that honesty is the best policy."
          },
          {
            "id": "L-S1E14-C09-T09",
            "speaker": {
              "character": "Penelope",
              "version": "Penelope"
            },
            "text": "I'm sorry. Did you just put \"Hope\" and \"honesty\" in the same sentence? You are all so blind to the hypocrisy of this place."
          },
          {
            "id": "L-S1E14-C09-T10",
            "speaker": {
              "character": "Penelope",
              "version": "Penelope"
            },
            "text": "You know what? Let me tell you how honest your girl is."
          }
        ]
      },
      "short": {
        "turns": [
          {
            "id": "L-S1E14-C09-T06",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "I came back from the dead...in a, in a burst of flames. And you'd think that would earn a guy a couple days of feeling special, but the irony about this place is that... special is just normal. "
          },
          {
            "id": "L-S1E14-C09-T07",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "All it takes is one good-looking vampire, and then I might as well be back at Mystic Falls High. Maybe I should just... tell Hope how jealous I am of Vampire Captain America."
          },
          {
            "id": "L-S1E14-C09-T08",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "I should put it all out there, right? And just say it. If I've learned anything from Hope, it's that honesty is the best policy."
          }
        ]
