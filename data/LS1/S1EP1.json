    {
      "id": "L-S1E01-C06",
      "title": "Hope and Alaric talk about Landon",
      "description": "Hope and Alaric talk about Landon",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Alaric",
