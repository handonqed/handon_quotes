       "full": {
        "turns": [
         {
          "id": "L-S1E02-C01-T01",
          "speaker": {
          "character": "Landon",
          "version": "Landon"
          },
          "text": "Raf? Holy hell. How did you find me?"
          },
          {
         "id": "L-S1E02-C01-T02",
         "speaker": {
          "character": "Rafael",
          "version": "Rafael"
         },
         "text": "There's, um, a-a lot of crazy witchy people looking for you. There's a bus full of burned-up people."
        },
       {
        "id": "L-S1E02-C01-T03",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "That wasn't me."
      },
      {
        "id": "L-S1E02-C01-T04",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "Then who was it?"
      },
      {
         "id": "L-S1E02-C01-T05",
         "speaker": {
          "character": "Rafael",
          "version": "Rafael"
         },
         "text": "You said three minutes."
        },
        {
        "id": "L-S1E02-C01-T06",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "Like I said, people lie. Corporis impetu. Where's the knife?"
      },
      {
        "id": "L-S1E02-C01-T07",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "I don't have it. I must've lost it when I ran."
      },
      {
        "id": "L-S1E02-C01-T08",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "After you burned the bus?"
      },
      {
        "id": "L-S1E02-C01-T09",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "That wasn't me, I swear. I barely got out alive."
      },
      {
         "id": "L-S1E02-C01-T10",
         "speaker": {
          "character": "Rafael",
          "version": "Rafael"
         },
         "text": "Hope, come on."
        },
        {
        "id": "L-S1E02-C01-T11",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "Who the hell was it?"
      },
      {
        "id": "L-S1E02-C01-T12",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "There was this girl..."
      }
        
    ]
  },

