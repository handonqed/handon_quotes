{
      "id": "L-S1E02-C04",
      "title": "Landon's letter to Hope",
      "description": "Landon letter to Hope",
      "participants": [
  
        {
          "character": "Landon",
          "version": "Landon"
        }
      ],
      "subjects": [],
      "scene_type": "letter",
      "tags": [
        "angst",
        "sorry",
        "memories",
        "goodbye"
      ],
      "importance": 4,
      "verified": true,


       "full": {
        "turns": [
         {
          "id": "L-S1E02-C04-T01",
          "speaker": {
          "character": "Landon",
          "version": "Landon"
          },
          "text": "Dear Hope, you strike me as the kind of person who's not so big on second chances, much less third, but I'm gonna give it a shot."
          },
          {
         "id": "L-S1E02-C04-T02",
         "speaker": {
          "character": "Landon",
          "version": "Landon"
         },
         "text": " I can't explain why I took that knife. Believe me, I wish I could. But maybe I can explain why I ran."
        },
       {
          "id": "L-S1E02-C04-T03",
          "speaker": {
          "character": "Landon",
          "version": "Landon"
          },
          "text": "I have never been welcomed anywhere in my life. I'm always the extra. The mouth they didn't want to feed."
          },
          {
         "id": "L-S1E02-C04-T04",
         "speaker": {
          "character": "Landon",
          "version": "Landon"
         },
         "text": "If I caused trouble, I was out. When you grow up like that, you learn how to protect yourself. You do what you have to do to survive."
        },
        {
          "id": "L-S1E02-C04-T05",
          "speaker": {
          "character": "Landon",
          "version": "Landon"
          },
          "text": "I never had a real family. And that's not meant to make you feel sorry for me. I'm trying to make you understand."
          },
          {
         "id": "L-S1E02-C04-T06",
         "speaker": {
          "character": "Landon",
          "version": "Landon"
         },
         "text": "I lied to protect myself, but in doing so, I hurt you. And for that, I will be forever sorry."
        },
        {
         "id": "L-S1E02-C04-T07",
         "speaker": {
          "character": "Landon",
          "version": "Landon"
         },
         "text": "The time I spent with you the other night was one of the happiest moments in my life. I hate that I ruined it. Your school's secret is safe with me. With regret, Landon."
        }
     
        
    ]
  },

