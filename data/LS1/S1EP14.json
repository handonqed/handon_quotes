    {
      "id": "L-S1E14-C03",
      "title": "Hope talks with Alaric about her struggle with the trauma of losing Landon.",
      "description": "Hope talks with Alaric about her struggle with the trauma of losing Landon.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Alaric",
          "version": "Alaric"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "trauma",
        "grief",
        "boyfriend"
      ],
      "importance": 3,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S1E14-C03-T01",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "So, what's wrong with you?"
          },
          {
            "id": "L-S1E14-C03-T02",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Nothing, I'm fine."
          },
          {
            "id": "L-S1E14-C03-T03",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Landon told me about your little incident."
          },
          {
            "id": "L-S1E14-C03-T04",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Isn't boyfriend confidentiality a thing? It should be."
          },
          {
            "id": "L-S1E14-C03-T05",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "He's just worried about you, that's all."
          },
          {
            "id": "L-S1E14-C03-T06",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "He doesn't need to be."
          },
          {
            "id": "L-S1E14-C03-T07",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Are you sure? It seems like you're manifesting a little stress and anxiety. My guess is, you're still dealing with the trauma of seeing Landon dead."
          },
          {
            "id": "L-S1E14-C03-T08",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I've been through worse."
          },
          {
            "id": "L-S1E14-C03-T09",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "I mean, with your family history, I just want to make sure..."
          },
          {
            "id": "L-S1E14-C03-T10",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I said I'm fine!"
          },
          {
            "id": "L-S1E14-C03-T11",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "action": "magic wave"
          },
          {
            "id": "L-S1E14-C03-T12",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Okay. I-I could stand to blow off some steam. I'm gonna... go check the woods to see if I can wolf out."
          }
        ]
      },
      "short": {
        "turns": [
          {
            "id": "L-S1E14-C03-T03",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Landon told me about your little incident."
          },
          {
            "id": "L-S1E14-C03-T04",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Isn't boyfriend confidentiality a thing? It should be."
          },
          {
            "id": "L-S1E14-C03-T05",
