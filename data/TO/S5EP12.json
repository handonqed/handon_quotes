  "conversations": [
    {
      "id": "TO-S5E12-C01",
      "title": "Landon brings Hope her milkshake",
      "description": "Landon brings Hope her usual milkshake at the Mystic Grill. They talk about Hope not being around much, New Orleans, music, and the possibility of attending the festival.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Landon",
          "version": "Landon"
        },
        {
          "character": "Elijah",
          "version": "Elijah"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "first-appearance",
        "mystic-grill",
        "milkshake",
        "flirting",
        "new-orleans"
      ],
      "importance": 5,
      "verified": true,


       "full": {
        "turns": [
         {
          "id": "TO-S5EP12-C01-T01",
          "speaker": {
          "character": "Landon",
          "version": "Landon"
          },
          "text": "Peanut butter blast, whipped cream on the bottom. Just how you like it."
          },
          {
         "id": "TO-S5EP12-C01-T02",
         "speaker": {
          "character": "Hope",
          "version": "Hope"
         },
         "text": "Thanks, Landon."
        },
       {
        "id": "TO-S5EP12-C01-T03",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Yeah."
      },
      {
        "id": "TO-S5EP12-C01-T04",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "Uh, this is my uncle."
      },
      {
        "id": "TO-S5EP12-C01-T05",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Nice to meet you, Mr. Marshall. So, Hope.You haven't been around much lately."
      },
      {
        "id": "TO-S5EP12-C01-T06",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "Oh, yeah, there's been stuff back at home."
      },
      {
        "id": "TO-S5EP12-C01-T07",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Oh. Well, I was, I was hoping you'd be back. I mean, you're from New Orleans, right? I've always wanted to go. It's home to some of the greatest musicians of all time."
      },
      {
        "id": "TO-S5EP12-C01-T08",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "You should go. No matter where you are, there's always someone playing a Louis Armstrong song somewhere."
      },
      {
        "id": "TO-S5EP12-C01-T09",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Uh, actually, there's, um, there's music in the square tonight. I mean, they do it all the time, but tonight there's this kind of bluesy vibe and I thought maybe if you wanted..."
      },
      {
        "id": "TO-S5EP12-C01-T10",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "Oh, Landon, I-I can't tonight.I have a thing."
      },
        {
        "id": "TO-S5EP12-C01-T11",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Right, yeah. I should probably pick up an extra shift anyway."
      },
      {
        "id": "TO-S5EP12-C01-T12",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "No, thanks though, for asking and for the milkshake."
      },
      {
        "id": "TO-S5EP12-C01-T13",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Yeah. It was nice to meet you."
      },
      {
        "id": "TO-S5EP12-C01-T14",
        "speaker": {
          "character": "Elijah",
          "version": "Elijah"
        },
        "text": "And you."
      }
    ]
  },

  "short": {
    "turns": [
