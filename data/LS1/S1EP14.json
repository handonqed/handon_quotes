{
      "id": "L-S1E14-C02",
      "title": "Landon talks with Alaric about Hope's incident.",
      "description": "Landon talks with Alaric about Hope's incident.",
      "participants": [
        {
          "character": "Landon",
          "version": "Landon"
        },
