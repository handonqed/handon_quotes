    {
      "id": "L-S2E03-C09",
      "title": "Hope turns into a wolf to draw the monster away from Landon.",
      "description": "When the Shunka attacks and magic doesn't stop it, Hope undresses to turn into a wolf and lure it away, and Landon realizes she is more than a witch.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
