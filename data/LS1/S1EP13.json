        },
        
        {
          "character": "Rafael",
          "version": "Rafael"
        },
        {
          "character": "MG",
          "version": "MG"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "resurrection",
        "grief",
        "crying",
        "phoenix"
      ],
      "importance": 4,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S1E13-C05-T01",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "action": "sobbing"
          },

          {
            "id": "L-S1E13-C05-T02",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Raf. Raf. Please, Raf. Raf. Landon wouldn't want this. He wanted us to be better. Give him that respect. Give him respect."
          },

          {
            "id": "L-S1E13-C05-T03",
            "speaker": {
              "character": "MG",
              "version": "MG"
            },
            "text": "Uh... Am I still delusional or do y'all see this?"
          },
          {
            "id": "L-S1E13-C05-T04",
            "speaker": {
              "character": "Rafael",
              "version": "Rafael"
            },
            "text": "Put him out, Hope."
          },
          {
            "id": "L-S1E13-C05-T05",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Uh... Adiuuatur. It's not working. I... Wh-What's going on?"
          },
          {
            "id": "L-S1E13-C05-T06",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "I don't know. I've never seen anything like this."
          },
          {
            "id": "L-S1E13-C05-T07",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "No. Not yet, not yet. I don't think it's over."
          },
          {
            "id": "L-S1E13-C05-T08",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "What's not over?"
          },
          {
            "id": "L-S1E13-C05-T09",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "We've been wondering if he's supernatural. We have our answer."
          },
          {
            "id": "L-S1E13-C05-T10",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "What?"
          },
          {
            "id": "L-S1E13-C05-T11",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "What's going on?"
          },
          {
            "id": "L-S1E13-C05-T12",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "You ever heard of the legend of the Phoenix?"
          }
        ]
      },
      "short": {
        "turns": [
          {
            "id": "L-S1E13-C05-T08",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "What's not over?"
          },
          {
            "id": "L-S1E13-C05-T09",
