        }

      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "memories",
        "explanation",
        "comfort"
      ],
      "importance": 3,
      "verified": true,


       "full": {
        "turns": [
         {
          "id": "L-S1E01-C08-T01",
          "speaker": {
          "character": "Hope",
          "version": "Hope"
          },
          "text": "Are you crazy?! I almost ed you!"
          },
          {
          "id": "L-S1E01-C08-T02",
          "speaker": {
          "character": "Hope",
          "version": "Hope"
          },
          "text": "Don't touch that."
          },
          {
         "id": "L-S1E01-C08-T03",
         "speaker": {
          "character": "Landon",
          "version": "Landon"
         },
         "text": "Sorry. I didn't. I-I mean, I wasn't. Where are we?"
        },
       {
        "id": "L-S1E01-C08-T04",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "Uh, the Stefan Salvatore Memorial Library. All the artifacts in here have a supernatural history."
      },
      {
        "id": "L-S1E01-C08-T05",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "What's the story on this one?"
      },
      {
        "id": "L-S1E01-C08-T06",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "No idea, but in my experience your safest bet is to not touch it."
      },
      {
        "id": "L-S1E01-C08-T07",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Noted."
      },
      {
        "id": "L-S1E01-C08-T08",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "I'm sorry about earlier. You shouldn't have been out there."
      },
      {
        "id": "L-S1E01-C08-T09",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Yeah. I'll file that under the things that seem really obvious after the fact. So... I guess this means you're a werewolf. He said, casually."
      },
      {
        "id": "L-S1E01-C08-T10",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "I'm a lot of things."
      },
       {
        "id": "L-S1E01-C08-T11",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Care to elaborate?"
      },
      {
        "id": "L-S1E01-C08-T12",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "They're just gonna make you forget tomorrow."
      },
      {
        "id": "L-S1E01-C08-T13",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Come on. Humor me."
      }
    
    
    ]
  },

