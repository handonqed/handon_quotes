    {
      "id": "L-S1E05-C02",
      "title": "Hope and Landon continue the supernatural tests",
      "description": "Hope and Landon continue testing Landon's abilities.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Landon",
          "version": "Landon"
        },
        {
          "character": "Emma",
          "version": "Emma"
        }
      ],
      "subjects": [

      ],
      "scene_type": "conversation",
      "tags": [
        "tests",
        "identity",
        "school"
      ],
      "importance": 1,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S1E05-C02-T01",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Hey, I'm doing it. Now what?"
          },
          {
            "id": "L-S1E05-C02-T02",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Hold it for ten minutes."
          },

          {
            "id": "L-S1E05-C02-T03",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "What?"
          },
          {
            "id": "L-S1E05-C02-T04",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "You can stop. You failed. You have no supernatural strength."
          },

          {
            "id": "L-S1E05-C02-T05",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "What's next?"
          },
          {
            "id": "L-S1E05-C02-T05",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Next?"
          },
          {
            "id": "L-S1E05-C02-T05",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "You failed the vertical climb, the long jump, and you straight-up refused to swim across the lake."
          },
          {
            "id": "L-S1E05-C02-T05",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Yeah, well, excuse the foster kid for never having swim lessons. Look, I might suck at-at... everything, apparently, but I only have to pass one test to stay, so I'm not giving up yet."
          },

          {
            "id": "L-S1E05-C02-T06",
            "speaker": {
              "character": "Emma",
              "version": "Emma"
            },
            "text": "How's it going?"
          },
           {
            "id": "L-S1E05-C02-T07",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Landon was about to run sprints to the lake and back."
          },
          {
            "id": "L-S1E05-C02-T08",
            "speaker": {
              "character": "Emma",
              "version": "Emma"
            },
            "text": "What are you testing for exactly?"
          },
           {
            "id": "L-S1E05-C02-T09",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "His ability to get away from me as quickly as possible. If he's gonna stay in this school, it's a must."
          },
           {
            "id": "L-S1E05-C02-T10",
            "speaker": {
              "character": "Emma",
              "version": "Emma"
            },
            "text": "Did you run the lineage spell that I left you?"
          },
           {
            "id": "L-S1E05-C02-T11",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Yeah, first thing. Zero magic in his bloodline."
          },
          {
            "id": "L-S1E05-C02-T12",
            "speaker": {
              "character": "Emma",
              "version": "Emma"
            },
            "text": "Most humans have some trace of magical blood in their veins from a far-flung ancestor."
          },
           {
            "id": "L-S1E05-C02-T13",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "So what does that mean?"
          },
          {
            "id": "L-S1E05-C02-T14",
            "speaker": {
              "character": "Emma",
              "version": "Emma"
            },
            "text": "We need to learn more about Landon's past."
          }
        ]
      },
      "short": {
        "turns": [
          {
            "id": "L-S1E05-C02-T08",
            "speaker": {
              "character": "Emma",
              "version": "Emma"
            },
            "text": "What are you testing for exactly?"
          },
           {
            "id": "L-S1E05-C02-T09",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "His ability to get away from me as quickly as possible. If he's gonna stay in this school, it's a must."
          }
        ]
      }
