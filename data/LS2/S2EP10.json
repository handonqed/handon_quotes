          {
            "id": "L-S2E10-C01-T01",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "What the hell?"
          },
          {
            "id": "L-S2E10-C01-T02",
            "speaker": {
              "character": "Alyssa",
              "version": "Alyssa"
            },
            "text": "Are you blind? I spelled the knob to \"do not disturb.\""
          },
          {
            "id": "L-S2E10-C01-T03",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I need my chemistry of magic textbook. And more importantly, why are you on my bed?"
          },
          {
            "id": "L-S2E10-C01-T04",
            "speaker": {
              "character": "Alyssa",
              "version": "Alyssa"
            },
            "text": "I thought it'd be nice if it saw some action."
          },
          {
            "id": "L-S2E10-C01-T05",
            "speaker": {
              "character": "Jed",
              "version": "Jed"
            },
            "text": "I'm sorry, Hope."
          },
          {
            "id": "L-S2E10-C01-T06",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I'm crashing at Landon's."
          },
          {
            "id": "L-S2E10-C01-T07",
            "speaker": {
              "character": "Alyssa",
              "version": "Alyssa"
            },
            "text": "Have fun holding hands."
          }
        ]
      },
