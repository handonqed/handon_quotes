{
      "id": "L-S1E01-C08",
      "title": "Hope and Landon talk in the library",
      "description": "Hope and Landon talk  in the library, first part",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Landon",
