  "conversations": [
    {
      "id": "L-S2E04-C01",
      "title": "Hope tells Alaric that she and Landon were in love.",
      "description": "Hope admits what she had kept from Alaric: she and Landon were in love, and she is afraid of what telling him would do.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Alaric",
          "version": "Alaric"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "forgotten",
        "love",
        "confession",
        "angst",
        "protect",
        "secret"
      ],
      "importance": 5,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S2E04-C01-T01",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Hope Marshall to the principal's office."
          },
          {
            "id": "L-S2E04-C01-T02",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "P.A. system? It's a little dramatic, don't you think?"
          },
          {
            "id": "L-S2E04-C01-T03",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Not as dramatic as the message Landon left me, saying he had something urgent to discuss. Anything you want to share?"
          },
          {
            "id": "L-S2E04-C01-T04",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Only that I'm pretty sure the monsters are after him this time."
          },
          {
            "id": "L-S2E04-C01-T05",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "And you didn't think that that's something I should know?"
          },
          {
            "id": "L-S2E04-C01-T06",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "More like I was afraid of what you were gonna say after that."
          },
          {
            "id": "L-S2E04-C01-T07",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Hope. You need to go back to the Salvatore School."
          },
          {
            "id": "L-S2E04-C01-T08",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "That was it."
          },
          {
            "id": "L-S2E04-C01-T09",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Not for your sake. For theirs. Maybe Landon isn't that important to you. But if Malivore wants him, we need to want him more."
          },
          {
            "id": "L-S2E04-C01-T10",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Look, I will take care of it, but from a distance."
          },
          {
            "id": "L-S2E04-C01-T11",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Okay, what am I missing here, Hope? Hmm? You told me the truth, and everything worked out fine."
          },
          {
            "id": "L-S2E04-C01-T12",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Not the whole truth."
          },
          {
            "id": "L-S2E04-C01-T13",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Hmm."
          },
          {
            "id": "L-S2E04-C01-T14",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Landon and I... we were in love. Like, real love. Epic love, if that even exists."
          },
          {
            "id": "L-S2E04-C01-T15",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "I can assure you it does."
          },
          {
            "id": "L-S2E04-C01-T16",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Now he's with Josie, and they don't know what we were to each other. And I'm just afraid that if I tell them, she's gonna hate me forever or he's gonna hate me or I'm gonna hate myself because I made us all miserable."
          },
          {
            "id": "L-S2E04-C01-T17",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "So I can't tell them. Not yet."
          }
        ]
      },
      "short": {
        "turns": [
          {
            "id": "L-S2E04-C01-T14",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Landon and I... we were in love. Like, real love. Epic love, if that even exists."
          },
          {
            "id": "L-S2E04-C01-T15",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "I can assure you it does."
          }
        ]
      }
    },
