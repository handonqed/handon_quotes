        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "You are a really nice person, Hope Mikaelson. This is the part where you run."
      },
      {
        "id": "L-S1E01-C11-T05",
        "speaker": {
          "character": "Hope",
