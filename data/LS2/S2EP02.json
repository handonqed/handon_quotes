      ],
      "importance": 3,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S2E02-C02-T01",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Um... My name's not Hope Marshall. It's Hope Mikaelson. I'm Klaus and Hayley's daughter."
          },
          {
            "id": "L-S2E02-C02-T02",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "And I know you don't remember this, but, um... you're the closest thing I have to a father now."
          },
          {
            "id": "L-S2E02-C02-T03",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "And the entire world has forgotten that I exist, and the boy I love has moved on, so I have absolutely no idea what to do next."
          },
          {
            "id": "L-S2E02-C02-T04",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "action": "cries"
          },
          {
            "id": "L-S2E02-C02-T05",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "It's okay. We'll figure it out together."
          }
        ]
      },
      "short": {
        "turns": [
