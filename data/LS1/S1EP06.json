    {
      "id": "L-S1E06-C03",
      "title": "Hope explains she didn't just send Landon away.",
      "description": "Hope explains she didn't just send Landon away.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Rafael",
          "version": "Rafael"
        }
      ],
      "subjects": [
      ],
      "scene_type": "conversation",
      "tags": [
        "care",
        "family"
      ],
      "importance": 2,
      "verified": true,
      "full": {
        "turns": [
          
            {
            "id": "L-S1E06-C03-T01",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "One more minute."
          },
           {
            "id": "L-S1E06-C03-T02",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Raf, I didn't just send Landon away. I sent him to someone who's gonna help him find his birth mom."
          },
          {
            "id": "L-S1E06-C03-T03",
            "speaker": {
              "character": "Rafael",
              "version": "Rafael"
            },
            "text": "You sent him away by himself to find the woman that gave him up."
          },
         {
            "id": "L-S1E06-C03-T04",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "What if she's amazing, and he finally gets a family?"
          },
          {
            "id": "L-S1E06-C03-T05",
            "speaker": {
              "character": "Rafael",
              "version": "Rafael"
            },
            "text": "He had a family. He had me."
          },
          {
            "id": "L-S1E06-C03-T06",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "A crew isn't the same. Family is always and forever."
          },
          {
            "id": "L-S1E06-C03-T07",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Yeah, you're right. He's not my blood, but he is my brother. If anything, maybe you should try doubling down on friends to make up for the family you don't have."
          }
          
        ]
      },
