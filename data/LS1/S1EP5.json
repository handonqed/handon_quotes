    {
      "id": "L-S1E05-C06",
      "title": "Hope and Alaric talk about Landon and the honor council",
      "description": "Hope tells Alaric she wants a seat on the honor council, and he asks whether her interest is connected to Landon.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Alaric",
          "version": "Alaric"
        }
      ],
      "subjects": [
      ],
      "scene_type": "conversation",
      "tags": [
        "Landon",
        "council",
        "personal"
      ],
      "importance": 1,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S1E05-C06-T01",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "How's the interrogation going?"
          },
          {
            "id": "L-S1E05-C06-T02",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "She's not talking. But I think I figured out why no one remembers dragons, gargoyles or dryads existing. I mean, whatever happened to these creatures, it erased all memory of them. It's like they never existed in the first place."
          },

          {
            "id": "L-S1E05-C06-T03",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I guess that explains a lot."
          },

          {
            "id": "L-S1E05-C06-T03",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Well, don't sound so excited. It's only a massive piece of the puzzle that explains why these creatures only exist in legends and myths."
          },
          {
            "id": "L-S1E05-C06-T04",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Sorry. I'm just having a day."
          },
          {
            "id": "L-S1E05-C06-T05",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Listen, I want a seat on the council. I'm a tribrid... The only one of my kind. No one can represent my interests but me."
          },
          {
            "id": "L-S1E05-C06-T06",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Is this about Landon? Because you can't let this get personal."
          },
          {
            "id": "L-S1E05-C06-T07",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "The political is personal. I learned that in Advanced Civics, taught by you."
          },
          {
            "id": "L-S1E05-C06-T08",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "That's cheating. But I trust that you'll make the right call."
          }

        ]
      },
