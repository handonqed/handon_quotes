  "conversations": [
    {
      "id": "L-S1E16-C01",
      "title": "Hope tells Alaric she can't do nothing while Landon is in danger.",
      "description": "With Triad inside the school and her powers gone, Hope calls Alaric, who asks her not to do anything crazy. She reminds him that Landon is in danger too.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Alaric",
          "version": "Alaric"
        },
        {
          "character": "Dorian",
          "version": "Dorian"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "worry",
        "protect",
        "determination"
      ],
      "importance": 2,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S1E16-C01-T01",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Whoever this is gets extra credit."
          },
          {
            "id": "L-S1E16-C01-T02",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "It's Hope. Triad's here."
          },
          {
            "id": "L-S1E16-C01-T03",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Is everyone okay?"
          },
          {
            "id": "L-S1E16-C01-T04",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Yeah, but our powers are gone."
          },
          {
            "id": "L-S1E16-C01-T05",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "What do they want?"
          },
          {
            "id": "L-S1E16-C01-T06",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "They said that the third artifact is in the school somewhere."
          },
          {
            "id": "L-S1E16-C01-T07",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "You're kidding."
          },
          {
            "id": "L-S1E16-C01-T08",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "The Chalice of Arithmetic or something? I don't know. Any idea?"
          },
          {
            "id": "L-S1E16-C01-T09",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "We don't have the Chalice of Arimathea, do we?"
          },
          {
            "id": "L-S1E16-C01-T10",
            "speaker": {
              "character": "Dorian",
              "version": "Dorian"
            },
            "text": "I'd have to check the old Armory records, but not to my knowledge."
          },
          {
            "id": "L-S1E16-C01-T11",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Uh, listen, I, uh... I've got to find my way into the school. But just promise me you're not gonna do anything crazy."
          },
          {
            "id": "L-S1E16-C01-T12",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "We're not the only ones in danger. Landon is, too. I can't just stand here and do nothing."
          },
          {
            "id": "L-S1E16-C01-T13",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Hope, for once in your life, will you please just listen to me? If Triad wants the chalice, help them get the chalice. You don't have your powers. You are vulnerable, and if you try to resist, someone could get hurt. Do you understand me?"
          },
          {
            "id": "L-S1E16-C01-T14",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Yeah."
          }
        ]
      },
      "short": {
        "turns": [
          {
            "id": "L-S1E16-C01-T11",
            "speaker": {
              "character": "Alaric",
              "version": "Alaric"
            },
            "text": "Uh, listen, I, uh... I've got to find my way into the school. But just promise me you're not gonna do anything crazy."
          },
          {
            "id": "L-S1E16-C01-T12",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "We're not the only ones in danger. Landon is, too. I can't just stand here and do nothing."
          }
        ]
      }
    },
    {
      "id": "L-S1E16-C02",
      "title": "Lizzie, Josie and MG tell Hope to go save Landon.",
      "description": "Hope doesn't want to leave her friends behind at the school, but they insist she go rescue Landon while they handle Triad.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Lizzie",
          "version": "Lizzie"
        },
        {
          "character": "Josie",
          "version": "Josie"
        },
        {
          "character": "MG",
          "version": "MG"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "rescue"
      ],
      "importance": 1,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S1E16-C02-T01",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Okay. I'm gonna be back as soon as I can. Please keep these two from trying to kill or die for each other."
          },
          {
            "id": "L-S1E16-C02-T02",
            "speaker": {
              "character": "MG",
              "version": "MG"
            },
            "text": "You need to go help Landon. We don't need you to be here."
          },
          {
            "id": "L-S1E16-C02-T03",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "But I can't leave you guys here."
          },
          {
            "id": "L-S1E16-C02-T04",
            "speaker": {
              "character": "Lizzie",
              "version": "Lizzie"
            },
            "text": "For the love of Frodo, go rescue your Hobbit. We'll muddle through."
          },
          {
            "id": "L-S1E16-C02-T05",
            "speaker": {
              "character": "Josie",
              "version": "Josie"
            },
            "text": "She's right again. He needs you."
          },
          {
            "id": "L-S1E16-C02-T06",
            "speaker": {
              "character": "MG",
              "version": "MG"
            },
            "text": "We've been watching you save the day this entire school year, Hope. We got it."
          },
          {
            "id": "L-S1E16-C02-T07",
            "speaker": {
              "character": "Lizzie",
              "version": "Lizzie"
            },
            "text": "Now go save Landon."
          },
          {
            "id": "L-S1E16-C02-T08",
            "speaker": {
              "character": "Josie",
              "version": "Josie"
            },
            "text": "Go."
          },
          {
            "id": "L-S1E16-C02-T09",
            "speaker": {
              "character": "Lizzie",
              "version": "Lizzie"
            },
            "text": "If you go soft on us now, I'm just gonna hurl Maligoo."
          }
        ]
      },
      "short": {
        "turns": [
          {
            "id": "L-S1E16-C02-T02",
            "speaker": {
              "character": "MG",
