          },
          "text": "What does she want?"
          },
          {
         "id": "L-S1E02-C03-T02",
         "speaker": {
          "character": "Landon",
          "version": "Landon"
         },
         "text": " I don't know."
        },
       {
        "id": "L-S1E02-C03-T03",
        "speaker": {
          "character": "Rafael",
          "version": "Rafael"
        },
        "text": "Lan?"
      },
      {
        "id": "L-S1E02-C03-T04",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "Maybe she wants the knife you said you don't have."
      },
      {
         "id": "L-S1E02-C03-T05",
         "speaker": {
          "character": "Alaric",
          "version": "Alaric"
         },
         "text": "Back in the cellar. Go, go, go, go, go."
        },
        {
        "id": "L-S1E02-C03-T06",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "Where the hell is it?"
      },
      {
        "id": "L-S1E02-C03-T07",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "I'm sorry. I panicked."
      },
      {
        "id": "L-S1E02-C03-T08",
        "speaker": {
          "character": "Rafael",
          "version": "Rafael"
        },
        "text": "What the hell, Lan?"
      },
      {
        "id": "L-S1E02-C03-T09",
        "speaker": {
          "character": "Alaric",
          "version": "Alaric"
        },
        "text": "Hope, the doors."
      },
      {
         "id": "L-S1E02-C03-T10",
         "speaker": {
          "character": "Hope",
          "version": "Hope"
         },
         "text": "Got it. Adiuuatur. Okay, it's a quick fix. It won't last long."
        },
