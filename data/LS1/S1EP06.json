          {
            "id": "L-S1E06-C02-T01",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Listen, Raf, I know you're mad at me for sending Landon away, but... I promise you, it was for his own good."
          },
          {
            "id": "L-S1E06-C02-T02",
            "speaker": {
              "character": "Rafael",
              "version": "Rafael"
            },
            "text": "You've known him for two minutes, and you know what's good for him?"
          },
          {
            "id": "L-S1E06-C02-T03",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "I know that I want him to be safe."
          }
          
        ]
      },
      "short": {
        "turns": [
          {
