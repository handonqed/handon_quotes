      "importance": 3,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S1E14-C07-T01",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "In a situation like this, which one of us is supposed to apologize?"
          },
          {
            "id": "L-S1E14-C07-T02",
            "speaker": {
              "character": "Lizzie",
              "version": "Lizzie"
            },
            "text": "When it comes to jealousy? Always the guy."
          },
          {
            "id": "L-S1E14-C07-T03",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Hey."
          },
          {
            "id": "L-S1E14-C07-T04",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Hey."
          },
          {
            "id": "L-S1E14-C07-T05",
