    {
      "id": "L-S2E03-C06",
      "title": "Landon and Josie argue about Hope.",
      "description": "Landon feels bad about hurting Hope, while Josie insists she was faking and that there is something off about her.",
      "participants": [
        {
          "character": "Landon",
