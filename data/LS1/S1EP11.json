  {
      "id": "L-S1E11-C05",
      "title": "Hope and Landon talk to Dorian with Unicorn",
      "description": "Hope and Landon talk to Dorian with Unicorn",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Landon",
          "version": "Landon"
        },
        {
          "character": "Dorian",
          "version": "Dorian"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "unicorn",
        "monster"
      ],
      "importance": 1,
      "verified": true,


       "full": {
        "turns": [
         {
          "id": "L-S1E11-C05-T01",
          "speaker": {
          "character": "Hope",
          "version": "Hope"
          },
          "text": "Mr. Williams, we need your help. Dr. Saltzman's been MIA, and this creepy slug came out of my ear."
          },
          {
         "id": "L-S1E11-C05-T02",
         "speaker": {
          "character": "Dorian",
          "version": "Dorian"
         },
         "text": "Did it look like this?"
        },
       {
        "id": "L-S1E11-C05-T03",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Yep, exactly like that."
      },
      {
        "id": "L-S1E11-C05-T04",
        "speaker": {
          "character": "Dorian",
          "version": "Dorian"
        },
        "text": "This one tried getting into me. I was hoping it was the only one. I think our harmless friend the unicorn brought it onto school grounds to infect all of us."
      },
      {
          "id": "L-S1E11-C05-T05",
          "speaker": {
          "character": "Hope",
          "version": "Hope"
          },
          "text": "See? Harmless."
          }
    ]
  },

  "short": {
    "turns": [
      {
          "id": "L-S1E11-C05-T05",
          "speaker": {
          "character": "Hope",
          "version": "Hope"
          },
          "text": "See? Harmless."
          }
    ]
  }
