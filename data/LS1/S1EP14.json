{
      "id": "L-S1E14-C06",
      "title": "Hope and Landon practice the dance while talking about Roman.",
      "description": "Hope and Landon practice the dance while talking about Roman.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Landon",
          "version": "Landon"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "knife",
        "mother"
  
      ],
      "importance": 2,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S1E14-C06-T01",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "I can't believe you were so nice to him. After everything you told me he did to you and to your family, you can act like nothing happened?"
          },
          {
            "id": "L-S1E14-C06-T02",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "It's complicated. He spent half of his life desiccated in a cave. And then he was brainwashed by his mother, who was a literal nazi. And he's spent the last two years doing really good work for the school."
          },
          {
            "id": "L-S1E14-C06-T03",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Your mother is still dead. How does any of that exonerate him?"
          },
          {
            "id": "L-S1E14-C06-T04",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "It doesn't. But it's in the past. Leave it."
          },
          {
            "id": "L-S1E14-C06-T05",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "I suffered through how much torture because I stole a knife, and this guy has a hand in the death of your..."
          },
          {
            "id": "L-S1E14-C06-T06",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Landon, stop."
          }
        ]
      },
      "short": {
        "turns": [
          {
            "id": "L-S1E14-C06-T01",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "I can't believe you were so nice to him. After everything you told me he did to you and to your family, you can act like nothing happened?"
          },
          {
            "id": "L-S1E14-C06-T02",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "It's complicated."
          }
        ]
      }
    },
    {
