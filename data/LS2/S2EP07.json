    {
      "id": "L-S2E07-C02",
      "title": "SimuLandon tells Hope he loves her.",
      "description": "As Hope is about to leave for New Orleans, a Landon runs up and begs her not to go. She tells him she loves him too, not knowing he is a copy made from Landon's subconscious.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Landon",
          "version": "SimuLandon"
        },
        {
          "character": "Landon",
          "version": "Landon"
        }
      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "love",
        "confession",
        "goodbye"
      ],
      "importance": 4,
      "verified": true,
      "full": {
        "turns": [
          {
            "id": "L-S2E07-C02-T01",
            "speaker": {
              "character": "Landon",
              "version": "SimuLandon"
            },
            "text": "Hope! Don't go. I need you."
          },
          {
            "id": "L-S2E07-C02-T02",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Uh, I-I have to figure out a... a way to close the portal."
          },
          {
            "id": "L-S2E07-C02-T03",
            "speaker": {
              "character": "Landon",
              "version": "SimuLandon"
            },
            "text": "Then I'll come with you. I just couldn't stand losing you again. I love you, Hope Mikaelson."
          },
          {
            "id": "L-S2E07-C02-T04",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "Landon, I love you, too. Of course I love you."
          },
          {
            "id": "L-S2E07-C02-T05",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "action": "smiles"
          },
          {
            "id": "L-S2E07-C02-T06",
            "speaker": {
              "character": "Landon",
              "version": "Landon"
            },
            "text": "Aw, hell. You had to find Hope?"
          },
          {
            "id": "L-S2E07-C02-T07",
            "speaker": {
              "character": "Hope",
              "version": "Hope"
            },
            "text": "What the hell is happening?"
          }
        ]
      },
      "short": {
        "turns": [
