        }

      ],
      "subjects": [],
      "scene_type": "conversation",
      "tags": [
        "crush",
        "like"
      ],
      "importance": 2,
      "verified": true,


       "full": {
        "turns": [
         {
          "id": "L-S1E01-C06-T01",
          "speaker": {
          "character": "Hope",
          "version": "Hope"
          },
          "text": "You didn't have to lock him in the cellar."
          },
          {
         "id": "L-S1E01-C06-T02",
         "speaker": {
          "character": "Alaric",
          "version": "Alaric"
         },
         "text": "Where else was I gonna put him? Block with your hand."
        },
       {
        "id": "L-S1E01-C06-T03",
        "speaker": {
          "character": "Alaric",
          "version": "Alaric"
        },
        "text": "You and Landon have a thing or something?"
      },
      {
        "id": "L-S1E01-C06-T04",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "I don't have things."
      },
      {
        "id": "L-S1E01-C06-T05",
        "speaker": {
          "character": "Alaric",
          "version": "Alaric"
        },
        "text": "Yes, I'm well aware of your quest to avoid all emotional intimacy. There was obviously something."
      },
      {
        "id": "L-S1E01-C06-T06",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "I liked him. He's normal."
      },
      {
        "id": "L-S1E01-C06-T07",
        "speaker": {
          "character": "Alaric",
          "version": "Alaric"
        },
        "text": "Well, let's keep him that way. We survive here because we follow the rules. We can't get sloppy about it."
      },
      {
        "id": "L-S1E01-C06-T08",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "You're the one that's always telling me I need to get out more."
      },
      {
        "id": "L-S1E01-C06-T09",
        "speaker": {
          "character": "Alaric",
          "version": "Alaric"
        },
        "text": "I tell you that you need to stop locking yourself in your dorm room binge watching Cutthroat Kitchen. I don't tell you to go out and fraternize with the human locals."
      }
       
    
    ]
  },

