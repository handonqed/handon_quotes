    {
      "id": "L-S2E06-C04",
      "title": "Landon confronts Hope after remembering her.",
      "description": "Hope rescues Landon from the monster. With his memories back, he confronts her for not telling him, and she answers that she thought he was happier without her.",
      "participants": [
        {
          "character": "Hope",
          "version": "Hope"
        },
        {
          "character": "Landon",
          "version": "Landon"
        },
        {
