      "verified": true,


       "full": {
        "turns": [
         {
          "id": "L-S1E01-C07-T01",
          "speaker": {
          "character": "Hope",
          "version": "Hope"
          },
          "text": "Hey"
          },
          {
         "id": "L-S1E01-C07-T02",
         "speaker": {
          "character": "Landon",
          "version": "Landon"
         },
         "text": "Hope"
        },
       {
        "id": "L-S1E01-C07-T03",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "Can't sleep either?"
      },
      {
        "id": "L-S1E01-C07-T04",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Yeah, small spaces. You?"
      },
      {
        "id": "L-S1E01-C07-T05",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "Sometimes I get restless."
      },
      {
        "id": "L-S1E01-C07-T06",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Busy brain?"
      },
      {
        "id": "L-S1E01-C07-T07",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "Busy everything. My body has a lot going on inside of it."
      },
      {
        "id": "L-S1E01-C07-T08",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Which is an awesome segue into you telling me how you can move things with your mind."
      },
      {
        "id": "L-S1E01-C07-T09",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "You ask a lot of questions."
      },
       {
        "id": "L-S1E01-C07-T10",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Wouldn't you?"
      },
      {
        "id": "L-S1E01-C07-T11",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "Hmm. Why are you smiling?"
      },
      {
        "id": "L-S1E01-C07-T12",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "I'm remembering the day we danced, in the town square. This guy who used to mess with me in school finally got what was coming to him. I'd had a good day. Just like me to crush on the girl with the most baggage."
      },
    {
        "id": "L-S1E01-C07-T13",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "I'm gonna try that sleep thing again."
      },
       {
        "id": "L-S1E01-C07-T14",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "You know, you do that a lot."
      },
    {
        "id": "L-S1E01-C07-T15",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "Do what?"
      },
      {
        "id": "L-S1E01-C07-T16",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Leave."
      },
    {
        "id": "L-S1E01-C07-T17",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "I can be dangerous to people. It's better if I keep my distance."
      },
      {
        "id": "L-S1E01-C07-T18",
        "speaker": {
          "character": "Landon",
          "version": "Landon"
        },
        "text": "Better for who?"
      },
    {
        "id": "L-S1E01-C07-T19",
        "speaker": {
          "character": "Hope",
          "version": "Hope"
        },
        "text": "Again with the questions."
      }
    
    ]
  },

